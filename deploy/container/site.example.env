CE_RELEASE_VERSION=0.8.2
# Approved SHA256 of the signed dist (not of the changed-files archive).
CE_RELEASE_SHA256=REPLACE_WITH_APPROVED_64_HEX_SHA256
CE_DOMAIN=forum.example.com
CE_ADMIN_EMAIL=admin@example.com
CE_NAMESPACE=community-prod
CE_SECRETS_DIR=/srv/cajeer-forum-secrets
CE_HTTPS_PORT=443
CE_BIND_ADDRESS=0.0.0.0
# PostgreSQL queues are included in existing recovery sets; Redis queues are opt-in.
CE_QUEUE_DRIVER=pgsql
