// Install as root into /etc/polkit-1/rules.d/ after reviewing the actual units.
// Never authorize daemon-reload, arbitrary units, unit files or root commands.
polkit.addRule(function(action, subject) {
    if (action.id !== "org.freedesktop.systemd1.manage-units" || subject.user !== "cajeer-updater") return;
    var unit = action.lookup("unit");
    var verb = action.lookup("verb");
    var units = ["php8.4-fpm.service", "cajeerengine-worker.service", "cajeerengine-scheduler.service", "cajeerengine-scheduler.timer"];
    if ((verb === "start" || verb === "stop") && units.indexOf(unit) !== -1) return polkit.Result.YES;
});
