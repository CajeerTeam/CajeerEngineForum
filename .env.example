APP_NAME="CajeerEngine Forum Edition"
APP_ENV=local
APP_DEBUG=false
APP_URL=http://127.0.0.1:8080
APP_KEY=base64:CHANGE_ME
JWT_SECRET=CHANGE_ME
API_TOKEN_SECRET=CHANGE_ME
WEBHOOK_SIGNING_SECRET=CHANGE_ME
APP_LOCALE=ru

# Optional SkiF4er ID confidential web login. Requires APP_URL=https://FORUM_HOST,
# a registered Keycloak client with /auth/oidc/callback and a valid 32-byte
# base64 APP_KEY (or independent SKIF4ER_ID_TRANSACTION_KEY). Never commit secrets.
SKIF4ER_ID_ENABLED=false
SKIF4ER_ID_CLIENT_ID=
SKIF4ER_ID_CLIENT_SECRET=
# Opt-in: permit new verified SkiF4er ID users to register as forum-member.
# Both FORUM_REGISTRATION and the live community policy must also allow it.
# Existing linked users can log in even when registration is disabled.
SKIF4ER_ID_AUTO_PROVISION=false
SKIF4ER_ID_TRANSACTION_KEY=

DB_DRIVER=pgsql
# Для demo/local можно поставить DB_DRIVER=sqlite и SQLITE_DATABASE=storage/database/cajeer.sqlite
SQLITE_DATABASE=storage/database/cajeer.sqlite
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=cajeerengine
DB_USERNAME=cajeerengine
DB_PASSWORD=secret
DB_SSLMODE=prefer

# Optional DB drivers: mysql, mariadb
MYSQL_CHARSET=utf8mb4
MYSQL_COLLATION=utf8mb4_unicode_ci

CACHE_DRIVER=redis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DATABASE=0
REDIS_USERNAME=
REDIS_TIMEOUT_SECONDS=0.5
# Unique per installation; required when enabling forum Redis cache/rate limits.
FORUM_REDIS_NAMESPACE=
FORUM_CACHE_ENABLED=false
FORUM_CACHE_TTL_SECONDS=60
RATE_LIMIT_DRIVER=file

QUEUE_DRIVER=file

SEARCH_DRIVER=file
MEILISEARCH_HOST=http://127.0.0.1:7700
MEILISEARCH_KEY=
OPENSEARCH_HOST=http://127.0.0.1:9200

STORAGE_DRIVER=local
STORAGE_LOCAL_PATH=storage/app
STORAGE_PUBLIC_UPLOADS_URL=/uploads
S3_ENDPOINT=
S3_BUCKET=
S3_REGION=auto
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_PATH_STYLE=true


RATE_LIMIT_GLOBAL=120
RATE_LIMIT_AUTH=20
RATE_LIMIT_FORUM_SEARCH=60
# PostgreSQL per-statement budget for forum search (100–30000 ms).
FORUM_SEARCH_TIMEOUT_MS=3000

APP_VERSION=1.3.0
LOG_RUNTIME=true
CONTENT_STORAGE=database
CMS_STORAGE=database

# Optional first admin for php bin/cajeer db:seed
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Administrator

# Security Core 0.5.0
SECURITY_REQUIRE_AUTH=true
SECURITY_PROTECT_CONTENT_WRITES=true
SECURITY_PROTECT_SYSTEM_ROUTES=true
RATE_LIMIT_WINDOW_SECONDS=60
SESSION_TTL_DAYS=14
PASSWORD_MIN_LENGTH=12
PASSWORD_REQUIRE_MIXED=true
PASSWORD_ARGON2_MEMORY=65536
PASSWORD_ARGON2_TIME=4
PASSWORD_ARGON2_THREADS=2


# Admin UI 1.1.4
ADMIN_PUBLIC_BASE=/admin/
ADMIN_API_BASE=/api/v1
ADMIN_PREBUILT_ASSETS=true

# CMS Public Layer 1.1.4
PUBLIC_DEFAULT_TEMPLATE=default.page
TEMPLATE_CACHE=true
MEDIA_STORAGE=file
MEDIA_MAX_UPLOAD_MB=25
MEDIA_REQUIRE_IMAGE_PROCESSOR=false
# Install ext-gd, or configure an absolute ImageMagick convert binary.
# MEDIA_CONVERT_BINARY=/usr/bin/convert
MEDIA_ALLOW_SVG=false


# Queue/Scheduler/Search/Webhooks 0.8.0
QUEUE_WORKER_LIMIT=10
QUEUE_LEASE_SECONDS=300
QUEUE_JOB_TIMEOUT_SECONDS=120
SCHEDULER_DRIVER=file
QUEUE_REDIS_PREFIX=ce:queue:
QUEUE_RETRY_BACKOFF=60
RABBITMQ_DSN=amqp://guest:guest@127.0.0.1:5672/%2f
RABBITMQ_EXCHANGE=cajeerengine.jobs
RABBITMQ_QUEUE_PREFIX=cajeerengine
SEARCH_DRIVER=file
WEBHOOK_TIMEOUT_SECONDS=10
SCHEDULER_ENABLE_SEARCH_INDEX=true
SCHEDULER_ENABLE_WEBHOOK_DISPATCH=true


# Extension System 1.0.6
EXTENSIONS_ALLOW_UNSIGNED_IN_DEV=false
EXTENSIONS_REQUIRE_SIGNATURE=true
EXTENSIONS_TRUST_DIR=
# Updates / Releases
# GitHub endpoints are built into core for https://github.com/cajeerteam/CajeerEngine
UPDATE_CHANNEL=stable
# stable / rc (and stable) / beta (and stable) / dev (all)
UPDATE_SEQUENTIAL=true
UPDATE_HTTP_TIMEOUT=5
# Optional: download and stage only; installation still needs approval.
UPDATE_AUTO_STAGE_ENABLED=false
UPDATE_AUTO_STAGE_INTERVAL_SECONDS=3600
# Optional read-only GitHub API credential; prefer a protected absolute file.
# UPDATE_GITHUB_TOKEN_FILE=/run/secrets/github-release-token
UPDATE_SIGNATURE_REQUIRED=true
# Web Upgrade is disabled by default; prefer CLI update in production.
UPDATE_WEB_UPGRADE_ENABLED=false
# Public trust key and backup encryption key are provisioned outside the project.
UPDATE_TRUSTED_PUBLIC_KEY_FILE=
BACKUP_KEY_FILE=
# Optional independent SQLite recovery interpreter (only if pdo_sqlite unavailable).
BACKUP_SQLITE_PYTHON=
# Set only after a successful disposable MySQL/MariaDB restore rehearsal.
BACKUP_MYSQL_RESTORE_CONFIRMED=false

# Installer / Import Export
IMPORT_EXPORT_MAX_BYTES=52428800

# Local HTML render cache: disabled by default; preview and signed themes bypass it.
PUBLIC_RENDER_CACHE_TTL=0

# Database session limits
DB_CONNECT_TIMEOUT=5
DB_STATEMENT_TIMEOUT_MS=30000
DB_LOCK_TIMEOUT_MS=5000
DB_IDLE_TRANSACTION_TIMEOUT_MS=60000
DB_MYSQL_LOCK_TIMEOUT_SECONDS=5
DB_SQLITE_BUSY_TIMEOUT_MS=5000
DB_SQLITE_WAL=false

# Observability (generate a dedicated random secret; never reuse an API token)
OBSERVABILITY_METRICS_TOKEN=
OBSERVABILITY_MIN_FREE_BYTES=104857600
OBSERVABILITY_BACKUP_MAX_AGE=86400
OBSERVABILITY_WORKER_MAX_AGE=300
OBSERVABILITY_QUEUE_MAX_AGE=300
OBSERVABILITY_LOG_MAX_BYTES=10485760
# Optional OTLP/HTTP JSON collector, full /v1/traces URL.
OBSERVABILITY_OTLP_ENDPOINT=
OBSERVABILITY_OTLP_TOKEN=
OBSERVABILITY_TRACE_SAMPLE_RATE=0.1

# Forum Edition: disable public signup for private communities.
FORUM_REGISTRATION=true

# Forum Identity & Access (0.1.3). Existing accounts remain active.
FORUM_REQUIRE_EMAIL_VERIFICATION=true
FORUM_SMTP_HOST=
FORUM_SMTP_PORT=587
FORUM_SMTP_SECURITY=starttls
FORUM_SMTP_FROM=
FORUM_SMTP_USERNAME=
FORUM_SMTP_PASSWORD=

# Forum attachment limits (MiB). Primary forum group can override defaults.
FORUM_ATTACHMENT_MAX_MB=5
FORUM_ATTACHMENT_QUOTA_MB=100
FORUM_ATTACHMENT_GROUP_LIMITS='{}'
# Optional private forum original replicas (unique prefix per installation)
FORUM_MEDIA_VARIANT_QUOTA_MB=100
FORUM_MEDIA_S3_REPLICA=false
FORUM_MEDIA_S3_PREFIX=

# Forum recycle bin retention (1–365 days; unresolved reports prevent purge)
FORUM_RECYCLE_RETENTION_DAYS=30

# Global warning thresholds (0 disables that automatic sanction)
FORUM_WARNING_POST_POINTS=5
FORUM_WARNING_SUSPEND_POINTS=10

# Forum anti-spam (rolling windows; new = unverified email or account under 7 days)
FORUM_SPAM_REGISTRATIONS_HOUR=5
FORUM_SPAM_REGISTRATIONS_GLOBAL_HOUR=100
FORUM_SPAM_NEW_THREADS_HOUR=6
FORUM_SPAM_THREADS_HOUR=30
FORUM_SPAM_NEW_REPLIES_10MIN=20
FORUM_SPAM_REPLIES_10MIN=60
FORUM_SPAM_EDITS_10MIN=30
FORUM_SPAM_NEW_PRIVATE_10MIN=20
FORUM_SPAM_PRIVATE_10MIN=60
FORUM_SPAM_REPORTS_HOUR=10
FORUM_SPAM_UPLOADS_HOUR=30
FORUM_SPAM_UPLOAD_MB_HOUR=100
FORUM_SPAM_REACTIONS_10MIN=60
FORUM_SPAM_VOTES_10MIN=60
FORUM_SPAM_NEW_LINKS=2
FORUM_SPAM_NEW_MENTIONS=5
FORUM_SPAM_MENTIONS=15
# Comma-separated DNS names; includes subdomains. Empty disables domain deny list.
FORUM_SPAM_BLOCKED_DOMAINS=
# Trusted domains do not count toward the new-account link limit (deny list wins).
FORUM_SPAM_ALLOWED_DOMAINS=

# Forum indexing (also respects CMS robots_index / sitemap_enabled)
FORUM_SEO_INDEX=true
# Comma-separated board UUIDs; excludes their descendants from sitemap and indexing
FORUM_SEO_EXCLUDED_BOARDS=

# Outbound integration policy (optional). Comma-separated exact HTTPS hostnames and provider IDs.
# Empty allowlists allow all already registered integration providers / public HTTPS hosts.
INTEGRATIONS_ENABLED=true
INTEGRATIONS_ALLOWED_HOSTS=
INTEGRATIONS_ALLOWED_PROVIDERS=
INTEGRATIONS_MAX_CONNECTIONS=200
INTEGRATIONS_MAX_PAYLOAD_BYTES=65536

# Platform Security & Privacy (1.4.7)
RATE_LIMIT_LOGIN_PAIR=8
RATE_LIMIT_LOGIN_ACCOUNT=30
AUDIT_NETWORK_RETENTION_DAYS=30
# Optional *_FILE credentials: use an absolute regular file (0600 or 0440).
# Do not set a nonempty direct value and its _FILE simultaneously.
# OPENAI_API_KEY_FILE=/run/secrets/openai
# DB_PASSWORD_FILE=/run/secrets/database
# REDIS_PASSWORD_FILE=/run/secrets/redis
# INTEGRATIONS_KEY_FILE=/run/secrets/integrations
